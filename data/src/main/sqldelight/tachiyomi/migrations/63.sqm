-- KMK -->
-- Migration 63: make the library and history chapter counts follow the smart merge switch, and
-- honour the narrowed blacklist key.
--
-- 1. Both aggregates counted distinct chapter numbers unconditionally, because migration 61
--    replaced the row counts that used to multiply a series across its scanlator groups by three.
--    That is the right basis while the merge is on - a merged list shows one upload per number -
--    and the wrong one with it off, where every upload is a chapter again and the details screen
--    lists all of them. Two scanlators each holding 1-10 showed "20 chapters" in the list and 10
--    on the Library badge, and the History tab's "read of total" and its unfinished-manga filter
--    were halved the same way. The views now carry both bases, and the queries pick one with
--    :smartScanlatorMerge - a view cannot take a parameter itself. On a series only one scanlator
--    carries, the two bases are equal, so nothing changes for the common case.
--
-- 2. The blacklist filter matched only the broad scanlatorBlacklistKey() form. A scanlator that
--    published the same chapter number twice gets a narrowed key carrying the upload url, so that
--    one was invisible here: read the version the reader had blacklisted, and its number was still
--    subtracted from the badge while its unread twin was the version on screen. Both key widths are
--    matched now, in libraryView and in historyView, with the scanlator trimmed and the url capped
--    the way ChapterBlacklist writes them.
--
-- A schema bump does not re-create a view on its own, so both are dropped and recreated. The
-- queries are not part of a migration: SQLDelight regenerates them from the .sq files, and
-- MangaMapper / HistoryMapper keep their signatures because the new columns are consumed by the
-- SELECT list, not handed to the mapper.

DROP VIEW IF EXISTS libraryView;

-- NOTE: must update MERGED_SOURCE_ID (6969) here
CREATE VIEW libraryView AS
SELECT
    M.*,
    coalesce(C.total, 0) AS totalCount,
    -- KMK --> The same four counts a second time, on the basis the merge is actually showing when
    -- the reader turns it off. Which pair the library badge and every other consumer uses is chosen
    -- by the queries below, with the smart merge switch as a parameter: a view cannot take one, and
    -- with the merge off every upload is a chapter again, so counting numbers alone reported half
    -- of what the details list showed.
    coalesce(C.totalUploads, 0) AS totalUploads,
    coalesce(C.readCount, 0) AS readCount,
    coalesce(C.readUploads, 0) AS readUploads,
    coalesce(C.latestUpload, 0) AS latestUpload,
    coalesce(C.fetchedAt, 0) AS chapterFetchedAt,
    coalesce(C.lastRead, 0) AS lastRead,
    coalesce(C.bookmarkCount, 0) AS bookmarkCount,
    coalesce(C.bookmarkUploads, 0) AS bookmarkUploads,
    -- KMK -->
    coalesce(C.bookmarkReadCount, 0) AS bookmarkedReadCount,
    coalesce(C.bookmarkReadUploads, 0) AS bookmarkedReadUploads,
    -- KMK <--
    coalesce(MC.categories, '0') AS categories
FROM mangas M
LEFT JOIN (
    SELECT
        chapters.manga_id,
        -- KMK --> Count chapter NUMBERS, not rows. Two scanlators uploading the same chapter are
        -- one chapter to the reader, so a plain row count reported a series with three groups as
        -- three times as long and inflated the unread badge (LibraryManga.unreadCount is derived
        -- from these). Recognised numbers are counted once each; chapters with no usable number
        -- (extras, oneshots) have nothing to deduplicate against and are still counted per row.
        -- The same four aggregates are all distinct-based so the set arithmetic in unreadCount
        -- (total - bookmark - (read - bookmarkRead)) stays non-negative: a number is counted as
        -- read or bookmarked if any of its uploads is, which keeps each set a subset of total.
        CAST(
            count(DISTINCT CASE WHEN chapters.chapter_number > 0
                THEN CAST(round(chapters.chapter_number * 100) AS INTEGER) END)
            + sum(CASE WHEN chapters.chapter_number <= 0 THEN 1 ELSE 0 END) AS INTEGER
        ) AS total,
        CAST(
            count(DISTINCT CASE WHEN chapters.chapter_number > 0 AND chapters.read = 1
                THEN CAST(round(chapters.chapter_number * 100) AS INTEGER) END)
            + sum(CASE WHEN chapters.chapter_number <= 0 AND chapters.read = 1 THEN 1 ELSE 0 END) AS INTEGER
        ) AS readCount,
        -- KMK --> Row basis, for the merge being off. Counted over the same filtered rows, so it
        -- agrees with the number basis on a series only one scanlator carries: there both fall out
        -- as one count per chapter, which is why nothing changes for the common case.
        CAST(count(*) AS INTEGER) AS totalUploads,
        CAST(sum(CASE WHEN chapters.read = 1 THEN 1 ELSE 0 END) AS INTEGER) AS readUploads,
        -- Known limit: a number counts as read when any of its uploads is, which is what the merge
        -- picks - it ranks a read upload above a better-ranked scanlator - with one exception. A
        -- scanlator range rule outranks read state, so a rule pinning scanlator X over a number
        -- whose read upload came from another scanlator reports that number as read while the list
        -- shows X's unread one. Closing it here would mean parsing scanlator_range_rules per
        -- chapter row; the rules are an explicit per-series override and the gap needs both one and
        -- the other, so it is left visible rather than papered over.
        -- KMK <--
        coalesce(max(chapters.date_upload), 0) AS latestUpload,
        coalesce(max(history.last_read), 0) AS lastRead,
        coalesce(max(chapters.date_fetch), 0) AS fetchedAt,
        CAST(
            count(DISTINCT CASE WHEN chapters.chapter_number > 0 AND chapters.bookmark = 1
                THEN CAST(round(chapters.chapter_number * 100) AS INTEGER) END)
            + sum(CASE WHEN chapters.chapter_number <= 0 AND chapters.bookmark = 1 THEN 1 ELSE 0 END) AS INTEGER
        ) AS bookmarkCount,
        CAST(sum(CASE WHEN chapters.bookmark = 1 THEN 1 ELSE 0 END) AS INTEGER) AS bookmarkUploads,
        CAST(
            count(DISTINCT CASE WHEN chapters.chapter_number > 0
                    AND chapters.bookmark = 1 AND chapters.read = 1
                THEN CAST(round(chapters.chapter_number * 100) AS INTEGER) END)
            + sum(CASE WHEN chapters.chapter_number <= 0
                AND chapters.bookmark = 1 AND chapters.read = 1 THEN 1 ELSE 0 END) AS INTEGER
        ) AS bookmarkReadCount,
        CAST(
            sum(CASE WHEN chapters.bookmark = 1 AND chapters.read = 1 THEN 1 ELSE 0 END) AS INTEGER
        ) AS bookmarkReadUploads,
        -- KMK <--
        excluded_scanlators.scanlator AS ex_scanlator
    FROM chapters
    LEFT JOIN excluded_scanlators
    ON chapters.manga_id = excluded_scanlators.manga_id
    AND chapters.scanlator = excluded_scanlators.scanlator
    LEFT JOIN history
    ON chapters._id = history.chapter_id
    -- KMK --> blacklisted chapters are hidden on the details screen, so they must not be
    -- counted here either. Key format matches scanlatorBlacklistKey(): rounded number@scanlator.
    LEFT JOIN mangas BM
    ON BM._id = chapters.manga_id
    -- KMK <--
    WHERE ex_scanlator IS NULL
    -- KMK -->
    AND (
        BM.blacklisted_chapters = ''
        OR (
            -- Broad key: every upload of that number from that scanlator.
            instr(
                ', ' || BM.blacklisted_chapters || ', ',
                ', ' || CAST(round(chapters.chapter_number * 100) / 100.0 AS TEXT)
                    || '@' || trim(coalesce(chapters.scanlator, '')) || ', '
            ) = 0
            -- Narrowed key: the one upload, for when a scanlator published the same number twice
            -- and blacklisting the pair would take both. Matching the broad key only left these
            -- chapters in the count, so a read upload the reader had blacklisted still subtracted
            -- its number from the badge while its unread twin was the one on screen.
            AND instr(
                ', ' || BM.blacklisted_chapters || ', ',
                ', ' || CAST(round(chapters.chapter_number * 100) / 100.0 AS TEXT)
                    || '@' || trim(coalesce(chapters.scanlator, '')) || '#'
                    || substr(trim(chapters.url), 1, 256) || ', '
            ) = 0
        )
    )
    -- KMK <--
    GROUP BY chapters.manga_id
) AS C
ON M._id = C.manga_id
LEFT JOIN (
    SELECT manga_id, group_concat(category_id) AS categories
    FROM mangas_categories
    GROUP BY manga_id
) AS MC
ON MC.manga_id = M._id
WHERE M.source <> 6969
UNION
SELECT
    M.*,
    coalesce(C.total, 0) AS totalCount,
    -- KMK --> Row basis again, for the merge being off.
    coalesce(C.totalUploads, 0) AS totalUploads,
    coalesce(C.readCount, 0) AS readCount,
    coalesce(C.readUploads, 0) AS readUploads,
    coalesce(C.latestUpload, 0) AS latestUpload,
    coalesce(C.fetchedAt, 0) AS chapterFetchedAt,
    coalesce(C.lastRead, 0) AS lastRead,
    coalesce(C.bookmarkCount, 0) AS bookmarkCount,
    coalesce(C.bookmarkUploads, 0) AS bookmarkUploads,
    -- KMK -->
    coalesce(C.bookmarkReadCount, 0) AS bookmarkedReadCount,
    coalesce(C.bookmarkReadUploads, 0) AS bookmarkedReadUploads,
    -- KMK <--
    coalesce(MC.categories, '0') AS categories
FROM mangas M
LEFT JOIN (
    SELECT merged.manga_id,merged.merge_id
    FROM merged
    GROUP BY merged.merge_id
) AS ME
ON ME.merge_id = M._id
LEFT JOIN(
    SELECT
        ME.merge_id,
        -- KMK --> Same distinct-chapter-number counting as the non-merged branch above, and it
        -- matters more here: chapters arrive from every manga in the merge, so the same number is
        -- routinely present several times over.
        CAST(
            count(DISTINCT CASE WHEN chapters.chapter_number > 0
                THEN CAST(round(chapters.chapter_number * 100) AS INTEGER) END)
            + sum(CASE WHEN chapters.chapter_number <= 0 THEN 1 ELSE 0 END) AS INTEGER
        ) AS total,
        CAST(
            count(DISTINCT CASE WHEN chapters.chapter_number > 0 AND chapters.read = 1
                THEN CAST(round(chapters.chapter_number * 100) AS INTEGER) END)
            + sum(CASE WHEN chapters.chapter_number <= 0 AND chapters.read = 1 THEN 1 ELSE 0 END) AS INTEGER
        ) AS readCount,
        -- KMK --> Row basis, for the merge being off.
        CAST(count(*) AS INTEGER) AS totalUploads,
        CAST(sum(CASE WHEN chapters.read = 1 THEN 1 ELSE 0 END) AS INTEGER) AS readUploads,
        -- KMK <--
        coalesce(max(chapters.date_upload), 0) AS latestUpload,
        coalesce(max(history.last_read), 0) AS lastRead,
        coalesce(max(chapters.date_fetch), 0) AS fetchedAt,
        CAST(
            count(DISTINCT CASE WHEN chapters.chapter_number > 0 AND chapters.bookmark = 1
                THEN CAST(round(chapters.chapter_number * 100) AS INTEGER) END)
            + sum(CASE WHEN chapters.chapter_number <= 0 AND chapters.bookmark = 1 THEN 1 ELSE 0 END) AS INTEGER
        ) AS bookmarkCount,
        CAST(sum(CASE WHEN chapters.bookmark = 1 THEN 1 ELSE 0 END) AS INTEGER) AS bookmarkUploads,
        CAST(
            count(DISTINCT CASE WHEN chapters.chapter_number > 0
                    AND chapters.bookmark = 1 AND chapters.read = 1
                THEN CAST(round(chapters.chapter_number * 100) AS INTEGER) END)
            + sum(CASE WHEN chapters.chapter_number <= 0
                AND chapters.bookmark = 1 AND chapters.read = 1 THEN 1 ELSE 0 END) AS INTEGER
        ) AS bookmarkReadCount,
        CAST(
            sum(CASE WHEN chapters.bookmark = 1 AND chapters.read = 1 THEN 1 ELSE 0 END) AS INTEGER
        ) AS bookmarkReadUploads,
        -- KMK <-- Read state carries the same one known limit as the branch above.
        excluded_scanlators.scanlator AS ex_scanlator
    FROM chapters
    LEFT JOIN excluded_scanlators
    ON chapters.manga_id = excluded_scanlators.manga_id
    AND chapters.scanlator = excluded_scanlators.scanlator
    LEFT JOIN history
    ON chapters._id = history.chapter_id
    LEFT JOIN merged ME
    ON ME.manga_id = chapters.manga_id
    -- KMK --> merged entries keep the blacklist on the parent, which is ME.merge_id
    LEFT JOIN mangas BM
    ON BM._id = ME.merge_id
    -- KMK <--
    WHERE ex_scanlator IS NULL
    -- KMK -->
    AND (
        BM.blacklisted_chapters = ''
        OR (
            instr(
                ', ' || BM.blacklisted_chapters || ', ',
                ', ' || CAST(round(chapters.chapter_number * 100) / 100.0 AS TEXT)
                    || '@' || trim(coalesce(chapters.scanlator, '')) || ', '
            ) = 0
            AND instr(
                ', ' || BM.blacklisted_chapters || ', ',
                ', ' || CAST(round(chapters.chapter_number * 100) / 100.0 AS TEXT)
                    || '@' || trim(coalesce(chapters.scanlator, '')) || '#'
                    || substr(trim(chapters.url), 1, 256) || ', '
            ) = 0
        )
    )
    -- KMK <--
    GROUP BY ME.merge_id
) AS C
ON M._id = C.merge_id  -- ON ME.merge_id = C.merge_id
LEFT JOIN (
    SELECT manga_id, group_concat(category_id) AS categories
    FROM mangas_categories
    GROUP BY manga_id
) AS MC
ON MC.manga_id = M._id
WHERE M.source = 6969;

DROP VIEW IF EXISTS historyView;

CREATE VIEW historyView AS
SELECT
    history._id AS id,
    mangas._id AS mangaId,
    chapters._id AS chapterId,
    mangas.title,
    mangas.thumbnail_url AS thumbnailUrl,
    mangas.source,
    mangas.favorite,
    mangas.cover_last_modified,
    chapters.chapter_number AS chapterNumber,
    -- KMK -->
    mangas.chapter_flags AS chapterFlags,
    chapters.read AS read,
    chapters.last_page_read AS lastPageRead,
    coalesce(C.total, 0) AS totalCount,
    coalesce(C.readCount, 0) AS readCount,
    coalesce(C.bookmarkCount, 0) AS bookmarkCount,
    coalesce(C.bookmarkReadCount, 0) AS bookmarkReadCount,
    -- KMK --> The same four counts on the row basis, for the merge being off. The queries below
    -- pick one basis or the other with :smartScanlatorMerge, the same preference the details list
    -- and the library badge read: with the merge off every upload is a chapter again, so a series
    -- carried by two groups showed "3 of 10" where the reader could see 20 chapters.
    coalesce(C.totalUploads, 0) AS totalUploads,
    coalesce(C.readUploads, 0) AS readUploads,
    coalesce(C.bookmarkUploads, 0) AS bookmarkUploads,
    coalesce(C.bookmarkReadUploads, 0) AS bookmarkReadUploads,
    -- KMK <--
    history.last_read AS readAt,
    history.time_read AS readDuration,
    max_last_read.last_read AS maxReadAt,
    max_last_read.chapter_id AS maxReadAtChapterId
FROM mangas
JOIN chapters
ON mangas._id = chapters.manga_id
JOIN history
ON chapters._id = history.chapter_id
JOIN (
    SELECT chapters.manga_id,chapters._id AS chapter_id, MAX(history.last_read) AS last_read
    FROM chapters JOIN history
    ON chapters._id = history.chapter_id
    GROUP BY chapters.manga_id
) AS max_last_read
ON chapters.manga_id = max_last_read.manga_id
-- KMK -->
LEFT JOIN(
    SELECT
        chapters.manga_id,
        -- KMK --> Same chapter-number counting as libraryView, for the same reason: a series with
        -- several scanlator groups stores one row per upload, so count(*) made the History tab's
        -- "read of total" progress and its unfinished filter count a chapter once per group. All
        -- four aggregates share one distinct basis so the arithmetic below cannot go negative.
        CAST(
            count(DISTINCT CASE WHEN chapters.chapter_number > 0
                THEN CAST(round(chapters.chapter_number * 100) AS INTEGER) END)
            + sum(CASE WHEN chapters.chapter_number <= 0 THEN 1 ELSE 0 END) AS INTEGER
        ) AS total,
        CAST(
            count(DISTINCT CASE WHEN chapters.chapter_number > 0 AND chapters.read = 1
                THEN CAST(round(chapters.chapter_number * 100) AS INTEGER) END)
            + sum(CASE WHEN chapters.chapter_number <= 0 AND chapters.read = 1 THEN 1 ELSE 0 END) AS INTEGER
        ) AS readCount,
        CAST(
            count(DISTINCT CASE WHEN chapters.chapter_number > 0 AND chapters.bookmark = 1
                THEN CAST(round(chapters.chapter_number * 100) AS INTEGER) END)
            + sum(CASE WHEN chapters.chapter_number <= 0 AND chapters.bookmark = 1 THEN 1 ELSE 0 END) AS INTEGER
        ) AS bookmarkCount,
        CAST(
            count(DISTINCT CASE WHEN chapters.chapter_number > 0
                AND chapters.bookmark = 1 AND chapters.read = 1
            THEN CAST(round(chapters.chapter_number * 100) AS INTEGER) END)
            + sum(CASE WHEN chapters.chapter_number <= 0
                AND chapters.bookmark = 1 AND chapters.read = 1 THEN 1 ELSE 0 END) AS INTEGER
        ) AS bookmarkReadCount,
        -- KMK --> Row basis, for the merge being off. Counted over the same filtered rows as the
        -- number basis above, so the two agree on a series only one scanlator carries.
        CAST(count(*) AS INTEGER) AS totalUploads,
        CAST(sum(CASE WHEN chapters.read = 1 THEN 1 ELSE 0 END) AS INTEGER) AS readUploads,
        CAST(sum(CASE WHEN chapters.bookmark = 1 THEN 1 ELSE 0 END) AS INTEGER) AS bookmarkUploads,
        CAST(
            sum(CASE WHEN chapters.bookmark = 1 AND chapters.read = 1 THEN 1 ELSE 0 END) AS INTEGER
        ) AS bookmarkReadUploads,
        -- KMK <--
        excluded_scanlators.scanlator AS ex_scanlator
    FROM chapters
    LEFT JOIN excluded_scanlators
    ON chapters.manga_id = excluded_scanlators.manga_id
    AND chapters.scanlator = excluded_scanlators.scanlator
    -- KMK --> Same blacklist filter libraryView applies. Without it a blacklisted chapter stays
    -- in this aggregate while the library badge and the details list have already dropped it, so
    -- the History tab's "read of total" and its unfinished filter disagree with both. Both key
    -- widths from scanlatorBlacklistKey() are matched: the broad one covers every upload of a
    -- number from a scanlator, the narrowed one a single upload, so blacklisting one version of a
    -- chapter a scanlator published twice no longer leaves it counted here.
    LEFT JOIN mangas BM
    ON BM._id = chapters.manga_id
    -- KMK <--
    WHERE ex_scanlator IS NULL
    -- KMK -->
    AND (
        BM.blacklisted_chapters = ''
        OR (
            instr(
                ', ' || BM.blacklisted_chapters || ', ',
                ', ' || CAST(round(chapters.chapter_number * 100) / 100.0 AS TEXT)
                    || '@' || trim(coalesce(chapters.scanlator, '')) || ', '
            ) = 0
            AND instr(
                ', ' || BM.blacklisted_chapters || ', ',
                ', ' || CAST(round(chapters.chapter_number * 100) / 100.0 AS TEXT)
                    || '@' || trim(coalesce(chapters.scanlator, '')) || '#'
                    || substr(trim(chapters.url), 1, 256) || ', '
            ) = 0
        )
    )
    -- KMK <--
    GROUP BY chapters.manga_id
) AS C
ON mangas._id = C.manga_id;
-- KMK <--

-- KMK --> Every projection below picks one counting basis with :smartScanlatorMerge and applies it
-- to all four aggregates at once, so the bookmark arithmetic stays inside a single basis: mixing
-- them is what migration 61 warned about, and a view cannot take the parameter itself.
--
-- The switch is the OUTER case on purpose. SQLDelight orders a query's parameters by where they
-- first appear in its text, so writing it there makes the generated signature
-- (smartScanlatorMerge, bookmarkUnmask, bookmarkMask, ...) read the same way the projection does.
-- Nested the other way round, :bookmarkMask would come first and the switch would land between the
-- two masks, which no reader of the call site could guess.

-- KMK <--
